{
  "name": "@aryasaatvik/motel",
  "version": "0.3.3",
  "description": "A local OpenTelemetry ingest + TUI viewer for development, backed by SQLite.",
  "type": "module",
  "license": "MIT",
  "author": "Kit Langton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/motel.git"
  },
  "homepage": "https://github.com/aryasaatvik/motel#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/motel/issues"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "tui",
    "sqlite",
    "effect",
    "opentui"
  ],
  "workspaces": [
    "web"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "protobufjs": "7.6.4",
    "shell-quote": "1.9.0",
    "ws": "8.21.0"
  },
  "files": [
    "src",
    "web/dist",
    "skills/motel-debug/SKILL.md",
    "skills/motel-debug/references/effect.md",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "bin": {
    "motel": "src/motel.ts",
    "motel-mcp": "src/mcp.ts"
  },
  "scripts": {
    "clear-motel-debug": "bun run skills/motel-debug/scripts/clear-motel-debug.ts",
    "dev": "MOTEL_OTEL_ENABLED=true bun run src/motel.ts tui",
    "start": "bun run src/motel.ts tui",
    "daemon": "bun run src/motel.ts daemon",
    "status": "bun run src/motel.ts status",
    "stop": "bun run src/motel.ts stop",
    "restart": "bun run src/motel.ts restart",
    "server": "bun run src/motel.ts server",
    "mcp": "bun run src/mcp.ts",
    "test": "bun test",
    "cli": "bun run src/motel.ts",
    "instructions": "bun run src/motel.ts instructions",
    "services": "bun run src/motel.ts services",
    "logs": "bun run src/motel.ts logs",
    "trace-logs": "bun run src/motel.ts trace-logs",
    "span-logs": "bun run src/motel.ts span-logs",
    "span": "bun run src/motel.ts span",
    "trace-spans": "bun run src/motel.ts trace-spans",
    "search-spans": "bun run src/motel.ts search-spans",
    "trace-stats": "bun run src/motel.ts trace-stats",
    "log-stats": "bun run src/motel.ts log-stats",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "story:chat": "bun run src/storybook/aiChatStory.tsx",
    "bench:motel-cold-start": "bun run scripts/bench-motel-cold-start.ts",
    "bench:ingest-logs": "bun run scripts/bench-ingest-logs.ts",
    "bench:ingest-traces": "bun run scripts/bench-ingest-traces.ts",
    "bench:search-spans": "bun run scripts/bench-search-spans.ts",
    "tegami": "bun scripts/tegami.mts",
    "version:packages": "bun run tegami version",
    "release:check": "bun run typecheck && bun run web:typecheck && bunx effect-language-service diagnostics --project tsconfig.json --format text && bun run test && bun run release:validate",
    "release": "bun run release:check && bun run tegami publish",
    "release:validate": "bun run scripts/validate-release.ts",
    "typecheck": "tsc --noEmit",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "prepublishOnly": "bun run web:build"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "tegami": "1.4.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/otlp-transformer": "0.214.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentui/core": "0.4.2",
    "@opentui/react": "0.4.2",
    "effect": "4.0.0-rc.112",
    "protobufjs": "7.6.4",
    "react": "^19.2.7",
    "scheduler": "^0.27.0"
  }
}
